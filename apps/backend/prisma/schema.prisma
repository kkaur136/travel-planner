// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Destination {
  id         Int        @id @default(autoincrement())
  city       String
  country    String
  activities Activity[]
}

model Activity {
  id            Int         @id @default(autoincrement())
  name          String
  duration      String
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
}
