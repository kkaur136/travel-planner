
{
  "name": "travel-planner-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:frontend": "npm run dev --workspace=frontend",
    "start:backend": "npm start --workspace=backend",
    "dev": "concurrently \"npm:start:frontend\" \"npm:start:backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "~6.0.2"
  }
}
